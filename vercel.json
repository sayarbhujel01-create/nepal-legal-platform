{
  "version": 2,
  "functions": {
    "api/index.js": {
      "includeFiles": "db/**"
    }
  },
  "rewrites": [
    {
      "source": "/css/(.*)",
      "destination": "/public/css/$1"
    },
    {
      "source": "/js/(.*)",
      "destination": "/public/js/$1"
    },
    {
      "source": "/favicon.svg",
      "destination": "/public/favicon.svg"
    },
    {
      "source": "/(.*)",
      "destination": "/api/index.js"
    }
  ]
}
